# =====================================================
# HR Properties Backend — Environment Variables
# =====================================================
# Copy this file to .env and fill in real values.
# All variables marked "required" MUST be set before docker compose up.

# === Required — Django Backend ===
SECRET_KEY=changeme-generate-a-real-django-secret-key
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
ADMIN_EMAILS=admin1@example.com,admin2@example.com
GMAIL_USER=your-gmail@gmail.com
GMAIL_PASSWORD=your-gmail-app-password

# === Required — Database (Neon externo) ===
DB_ENGINE=django.db.backends.postgresql
DB_NAME=hr-properties
DB_USER=hr
DB_PASSWORD=changeme-use-a-strong-password
# Neon host, ej: ep-cool-name-123456.us-east-2.aws.neon.tech
DB_HOST=your-neon-host.neon.tech
DB_PORT=5432

# === Required — CORS ===
# URL pública del frontend (para peticiones directas del SPA)
# Ejemplo: https://hr-properties.tu-dominio.com
CORS_ALLOWED_ORIGINS=https://hr-properties.tu-dominio.com

# === Required — Cloudflare Tunnel ===
# Get this from: Cloudflare Zero Trust → Networks → Tunnels → Create tunnel
TUNNEL_TOKEN=eyJ-your-tunnel-token-here

# === Optional (defaults shown) ===
DEBUG=False
# Hosts that Django will accept requests from (comma-separated)
ALLOWED_HOSTS=backend,localhost,127.0.0.1